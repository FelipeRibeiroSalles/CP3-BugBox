rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Só o próprio usuário lê e grava o seu perfil.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Bugs do usuário: users/{uid}/bugs/{bugId}
      match /bugs/{bugId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.severity in ['baixa', 'media', 'alta', 'critica']
          && request.resource.data.status in ['aberto', 'resolvido'];
      }
    }
  }
}
